{
  "expo": {
    "name": "صفارة",
    "slug": "sfara",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sfara",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1020",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1020"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
